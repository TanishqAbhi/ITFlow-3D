# ITFlow 3D - local environment template
# Copy this file to .env and replace every CHANGE_ME value before running.

PROJECT_NAME="ITFlow 3D Enterprise Platform"
API_V1_STR="/api/v1"

# Generate separate strong values with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="CHANGE_ME_GENERATE_A_UNIQUE_SECRET"
REFRESH_SECRET_KEY="CHANGE_ME_GENERATE_ANOTHER_UNIQUE_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Local development database
DATABASE_URL="sqlite:///./itflow3d.db"
# PostgreSQL example (install a matching driver before using):
# DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME"

# Replace/add your deployed frontend origin for production.
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Payment provider test credentials; configure real credentials only in deployment secrets.
RAZORPAY_KEY_ID="CHANGE_ME"
RAZORPAY_KEY_SECRET="CHANGE_ME"

# Optional Cloudinary configuration
CLOUDINARY_CLOUD_NAME="CHANGE_ME"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOAD_DIR="./uploads"

# Initial administrator bootstrap credentials; choose a unique strong password.
FIRST_SUPER_ADMIN_EMAIL="admin@example.com"
FIRST_SUPER_ADMIN_PASSWORD="CHANGE_ME_USE_A_STRONG_UNIQUE_PASSWORD"
